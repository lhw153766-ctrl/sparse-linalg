// Sparse linear algebra for MoonBit.
//
// Documentation: https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "lhw153766-ctrl/sparse-linalg"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/lhw153766-ctrl/sparse-linalg"

license = "Apache-2.0"

keywords = [
  "sparse",
  "matrix",
  "linear-algebra",
  "csr",
  "csc",
  "solver",
  "conjugate-gradient",
  "gmres",
  "cholesky",
  "numerical",
]

description = "Numeric sparse matrix storage (COO/CSR/CSC), sparse kernels, and iterative/direct solvers for MoonBit."

preferred_target = "wasm"

supported_targets = "all"
